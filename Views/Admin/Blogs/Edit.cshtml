@model devjamin.Models.BlogPostCreateEditViewModel
@{
    ViewData["Title"] = "Edit Blog";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Quill library (WYSIWYG-editor) -->
<link href="~/lib/quill@2.0.0-rc.3/quill.snow.css" rel="stylesheet" />
<script src="~/lib/quill@2.0.0-rc.3/quill.js"></script>

<style>
    /* Highlight active nav link */
    #blogNavItem a,
    #blogNavItem svg {
        color: #160042;
        fill: #160042;
    }
</style>

<h1 class="ceTitle">Edit Blog</h1>

<!-- Blog editor form -->
<form class="ceForm" asp-action="Edit" method="post">
    <input type="hidden" id="BlogPostId" name="BlogPostId" value="@Model.BlogPostId" />
    <div class="ceForm__groupContainer">
        <div class="ceForm__group">
            <label class="ceForm__label" for="Title">Title</label>
            <input class="ceForm__input" type="text" placeholder="Title" value="@Model.Title" id="Title" name="Title">
        </div>
        <div class="ceForm__group">
            <label class="ceForm__label" for="Slug">Slug</label>
            <input tabindex="-1" class="ceForm__input" type="text" placeholder="Slug" value="@Model.Slug" id="Slug" name="Slug">
        </div>
    </div>
    <div class="ceForm__group">
        <label class="ceForm__label" for="Description">Description</label>
        <textarea class="ceForm__textarea" id="Description" name="Description" cols="30"
            rows="10">@Model.Description</textarea>
    </div>
    <div class="ceForm__group">
        <label class="ceForm__label" for="Content">Content</label>
        <div class="ceForm__editor" id="Editor"></div>
        <input class="ceForm__input ceForm__input--hidden" type="hidden" value="@Model.Content" name="Content"
            id="Content">
    </div>
    <div class="ceForm__group">
        <div class="ceForm__mediaHeader">
            <p class="ceForm__mediaLabel">Media</p>
            <button class="ceForm__btn ceForm__btn--small" type="button" id="addMediaBtn">Add media</button>
        </div>
        <div class="ceForm__mediaContainer">
            <div class="ceForm__media" id="media">
                
            </div>
            <div class="ceForm__mediaOverlay ceForm__mediaOverlay--empty" id="mediaEmptyOverlay">
                <p>Empty...<br/>Add something by dragging or press "Add media"</p>
            </div>
            <div class="ceForm__mediaOverlay ceForm__mediaOverlay--dragging" id="mediaDraggingOverlay">
                <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24"><path d="M10 18v-10h-2.51l4.51-5.01 4.51 5.01h-2.51v10h-4zm-2 2h8v-10h5l-9-10-9 10h5v10zm11-1v3h-14v-3h-2v5h18v-5h-2z"/></svg>
            </div>
            <div class="ceForm__mediaOverlay ceForm__mediaOverlay--spinner" id="mediaLoadingOverlay">
                <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24"><path d="M23 12c0 1.042-.154 2.045-.425 3h-2.101c.335-.94.526-1.947.526-3 0-4.962-4.037-9-9-9-1.706 0-3.296.484-4.655 1.314l1.858 2.686h-6.994l2.152-7 1.849 2.673c1.684-1.049 3.659-1.673 5.79-1.673 6.074 0 11 4.925 11 11zm-6.354 7.692c-1.357.826-2.944 1.308-4.646 1.308-4.962 0-9-4.038-9-9 0-1.053.191-2.06.525-3h-2.1c-.271.955-.425 1.958-.425 3 0 6.075 4.925 11 11 11 2.127 0 4.099-.621 5.78-1.667l1.853 2.667 2.152-6.989h-6.994l1.855 2.681z"/></svg>
            </div>
        </div>
    </div>
    <div class="ceForm__bottom">
        <div class="ceForm__bottomCheckboxContainer">
            <input class="ceForm__bottomCheckbox" type="checkbox" name="IsPublished" id="IsPublished"
                @(Model.IsPublished == "on" ? "checked" : "")>
            <label class="ceForm__bottomLabel" for="IsPublished">Publish blog</label>
        </div>
        <div class="ceForm__btnWrapper">
            <a href="/Admin/Blogs/Delete/@Model.BlogPostId"
                onclick="return confirm('Are you sure you want to delete this blog post?');"
                class="ceForm__btn ceForm__btn--danger">Delete</a>
            <button class="ceForm__btn">Save</button>
        </div>
    </div>
</form>



<script>
    // Generate slug on title change (lowercase and replace spaces with hyphens)
    const titleInput = document.getElementById("Title");
    const slugInput = document.getElementById("Slug");

    titleInput.oninput = function () {
        const title = titleInput.value;
        const slug = title.toLowerCase().replace(/ /g, "-");
        slugInput.value = slug;
    };
</script>

<!-- Init Quill editor -->
<script>
    const options = {
        debug: "info",
        modules: {
            toolbar: [
                [{ "header": [1, 2, 3, 4, 5, 6, false] }],
                ["bold", "italic", "underline", "strike"],        // Toggled buttons
                [{ "list": "ordered" }, { "list": "bullet" }],
                ["blockquote", "code-block"],
                [{ "script": "sub" }, { "script": "super" }],      // Superscript/subscript
                [{ "indent": "-1" }, { "indent": "+1" }],          // Tutdent/indent
                [{ "direction": "rtl" }],                         // Text direction
                [{ "align": [] }],                                // Alignment tools
                ["clean"],                                        // Remove formatting
                ["link"]                       // Links, images, videos
            ],
            imageDropAndPaste: {
                // disable default base64 image upload
                handler: function () {
                    console.log("Image drop/paste disabled");
                    return false;
                },

            },
        },
        placeholder: "Compose an epic blog...",
        theme: "snow",
        // disable image drop
        imageDrop: false,
    };
    // Initialize Quill with existing content
    const quill = new Quill("#Editor", options);
    quill.root.innerHTML = document.getElementById("Content").value;

    // Quill editor
    const editorContainer = document.querySelector(".ql-editor");

    const form = document.querySelector("form");
    form.onsubmit = function (e) {
        // Set Quill content to hidden field
        document.getElementById("Content").value = quill.root.innerHTML;
    };

    /*  Prevent image drop in Quill editor. There are no way to disable image drop natively,
        so this is a workaround to remove the image from Quill's state after being dropped.
        Reason being Quill adds them as Base64... */
    editorContainer.addEventListener('drop', function(e) {
        e.preventDefault();

        setTimeout(() => {
            let imageDropped = false;
            let contents = quill.getContents();
            let ops = [];
            contents.ops.forEach(op => {
                if (op.insert && op.insert.image && op.insert.image.startsWith('data:image')) {
                    imageDropped = true;
                } else {
                    ops.push(op); // Keep all other ops
                }
            });

            if (imageDropped) {
                alert("Direct drag and drop is not allowed, use media upload instead.");
            }

            quill.setContents({ ops }); // Set modified contents without base64 images
        }, 100);
    });

    // Prevent images dropped outside of "Upload media" to replace tab
    document.addEventListener("drop", function(e) {
        e.preventDefault();
    }, false);
</script>


<!-- Image upload -->
<input type="file" id="mediaInput" hidden/>
<script>
    const blogPostId = @Model.BlogPostId;
    const mediaEl = document.getElementById("media");
    const addMediaBtn = document.getElementById("addMediaBtn");
    const mediaEmptyOverlay = document.getElementById("mediaEmptyOverlay");
    const mediaDraggingOverlay = document.getElementById("mediaDraggingOverlay");
    const mediaLoadingOverlay = document.getElementById("mediaLoadingOverlay");
    const mediaInput = document.getElementById("mediaInput");

    // Show empty overlay if no images
    if (mediaEl.children.length === 0) {
        mediaEmptyOverlay.style.display = "flex";
    }
    
    // Show and hide overlay on drag
    mediaEl.addEventListener("dragover", function (e) {
        e.preventDefault();
        mediaDraggingOverlay.style.display = "flex";
    });
    mediaEl.addEventListener("dragleave", function (e) {
        e.preventDefault();
        mediaDraggingOverlay.style.display = "none";
    });

    async function handleFiles(files) {
        // If no files, return
        if (files.length === 0) {
            return;
        }

        // Define allowed file types
        const allowedFileTypes = ["image/jpeg", "image/png", "video/mp4"];

        // Show spinner
        mediaLoadingOverlay.style.display = "flex";

        // Upload each allowed file
        for (let i = 0; i < files.length; i++) {
            const file = files[i];

            if (allowedFileTypes.includes(file.type)) {
                await uploadMedia(file, file.type);
            } else {
                console.warn(`File type '${file.type}' is not allowed.`);
            }

            // Hide spinner on last file
            if (i === files.length - 1) {
                mediaLoadingOverlay.style.display = "none";
            }
        }
    }

    async function uploadMedia(file, fileType) {
        const formData = new FormData();
        formData.append("File", file);
        formData.append("BlogPostId", @Model.BlogPostId);

        try {
            const response = await fetch("/API/Upload-Media", {
                method: "POST",
                body: formData,
                credentials: "same-origin"
            });

            console.log(response)
            if (!response.ok) {
                const errorData = await response.json();
                console.log(errorData)
                throw new Error(errorData.error || "An unknown error occurred");
            }

            // Parsing response
            const data = await response.json();
            const { mediaId, filePath } = data;

            function addMediaElement(imgOrVideoElement, isVideo = false) {
                const mediaElement = document.createElement("div");
                mediaElement.classList.add("ceForm__mediaElement");

                mediaElement.dataset.filePath = filePath;
                mediaElement.dataset.mediaId = mediaId;

                mediaElement.innerHTML = `
                    ${imgOrVideoElement.outerHTML}
                    <div class="ceForm__mediaElementToolbar">
                        ${!isVideo ? `
                            <button title="Make this blog cover image" type="button" class="ceForm__mediaElementToolbarElement ceForm__mediaElementToolbarElement--cover">
                                <svg clip-rule="evenodd" fill-rule="evenodd" stroke-linejoin="round" stroke-miterlimit="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="m7.234 3.004c-2.652 0-5.234 1.829-5.234 5.177 0 3.725 4.345 7.727 9.303 12.54.194.189.446.283.697.283s.503-.094.697-.283c4.977-4.831 9.303-8.814 9.303-12.54 0-3.353-2.58-5.168-5.229-5.168-1.836 0-3.646.866-4.771 2.554-1.13-1.696-2.935-2.563-4.766-2.563zm0 1.5c1.99.001 3.202 1.353 4.155 2.7.14.198.368.316.611.317.243 0 .471-.117.612-.314.955-1.339 2.19-2.694 4.159-2.694 1.796 0 3.729 1.148 3.729 3.668 0 2.671-2.881 5.673-8.5 11.127-5.454-5.285-8.5-8.389-8.5-11.127 0-1.125.389-2.069 1.124-2.727.673-.604 1.625-.95 2.61-.95z" fill-rule="nonzero"/></svg>
                            </button>
                        ` : ""}
                        <button title="Add this media at the current editor cursor position" type="button" class="ceForm__mediaElementToolbarElement ceForm__mediaElementToolbarElement--add">
                            <svg clip-rule="evenodd" fill-rule="evenodd" stroke-linejoin="round" stroke-miterlimit="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="m21 3.998c0-.478-.379-1-1-1h-16c-.62 0-1 .519-1 1v16c0 .621.52 1 1 1h16c.478 0 1-.379 1-1zm-16.5.5h15v15h-15zm6.75 6.752h-3.5c-.414 0-.75.336-.75.75s.336.75.75.75h3.5v3.5c0 .414.336.75.75.75s.75-.336.75-.75v-3.5h3.5c.414 0 .75-.336.75-.75s-.336-.75-.75-.75h-3.5v-3.5c0-.414-.336-.75-.75-.75s-.75.336-.75.75z" fill-rule="nonzero"/></svg>
                        </button>
                        <button title="Delete this media" type="button" class="ceForm__mediaElementToolbarElement ceForm__mediaElementToolbarElement--delete">
                            <svg clip-rule="evenodd" fill-rule="evenodd" stroke-linejoin="round" stroke-miterlimit="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="m4.015 5.494h-.253c-.413 0-.747-.335-.747-.747s.334-.747.747-.747h5.253v-1c0-.535.474-1 1-1h4c.526 0 1 .465 1 1v1h5.254c.412 0 .746.335.746.747s-.334.747-.746.747h-.254v15.435c0 .591-.448 1.071-1 1.071-2.873 0-11.127 0-14 0-.552 0-1-.48-1-1.071zm14.5 0h-13v15.006h13zm-4.25 2.506c-.414 0-.75.336-.75.75v8.5c0 .414.336.75.75.75s.75-.336.75-.75v-8.5c0-.414-.336-.75-.75-.75zm-4.5 0c-.414 0-.75.336-.75.75v8.5c0 .414.336.75.75.75s.75-.336.75-.75v-8.5c0-.414-.336-.75-.75-.75zm3.75-4v-.5h-3v.5z" fill-rule="nonzero"/></svg>
                        </button>
                    </div>
                `;

                const addBtn = mediaElement.querySelector(".ceForm__mediaElementToolbarElement--add");
                const coverBtn = mediaElement.querySelector(".ceForm__mediaElementToolbarElement--cover");
                const deleteBtn = mediaElement.querySelector(".ceForm__mediaElementToolbarElement--delete");

                // Add media on click at Quill cursor position
                addBtn.onclick = function () {
                    var range = quill.getSelection();

                    // No selection guard clause
                    if (!range) alert("No active selection")

                    if (range) {
                        quill.insertEmbed(range.index, 'image', `https://devjamin.fra1.cdn.digitaloceanspaces.com/${filePath}`);
                    }
                };

                // Set cover image
                coverBtn.onclick = async function () {
                    const data = {
                        BlogPostId: blogPostId,
                        MediaId: mediaId
                    };

                    try {
                        const response = await fetch("/API/Select-Cover-Image", {
                            method: "POST", // HTTP method
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify(data),
                        });

                        if (!response.ok) {
                            const errorData = await response.json();
                            console.error("Error selecting cover image:", errorData);
                            alert("Error selecting cover image: " + (errorData.Error || "Unknown error"));

                            return;
                        }

                        const responseData = await response.json();
                        console.log("Success:", responseData);
                        
                        // Toggle cover active class
                        if (coverBtn.classList.contains("ceForm__mediaElementToolbarElement--coverActive")) {
                            coverBtn.classList.remove("ceForm__mediaElementToolbarElement--coverActive");
                            coverBtn.title = "Make this blog cover image";
                        } else {
                            coverBtn.classList.add("ceForm__mediaElementToolbarElement--coverActive");
                            coverBtn.title = "Remove this as blog cover image";
                        }

                    } catch (error) {
                        console.error("Fetch error:", error);
                        alert("An error occurred while selecting the cover image.");
                    }
                };

                // Delete media
                deleteBtn.onclick = async function () {
                    // Ensure media is not in use in the editor
                    const range = quill.getSelection();
                    const mediaUrl = `https://devjamin.fra1.cdn.digitaloceanspaces.com/${filePath}`;
                    const mediaElementInEditor = quill.root.querySelector(`img[src="${mediaUrl}"]`);
                    if (mediaElementInEditor) {
                        alert("Media is present in the editor, remove it first.");
                        return;
                    }

                    try {
                        const response = await fetch(`/API/Delete-Media/${mediaId}`, {
                            method: "DELETE",
                        });

                        if (!response.ok) {
                            const errorData = await response.json();
                            console.error("Error deleting media:", errorData);
                            alert(errorData.error || "Unknown error");

                            return;
                        }

                        const responseData = await response.json();
                        console.log("Success:", responseData);

                        // Remove media element
                        mediaElement.remove();

                        // Show empty overlay if no images
                        if (mediaEl.children.length === 0) {
                            mediaEmptyOverlay.style.display = "flex";
                        }

                    } catch (error) {
                        console.error("Fetch error:", error);
                        alert("An error occurred while deleting the media.");
                    }
                };

                // Add media element to media container
                mediaEl.appendChild(mediaElement);
            }

            // Create either image or video element based on file type
            if (fileType === "video/mp4") {
                const video = document.createElement("video");
                video.src = `https://devjamin.fra1.cdn.digitaloceanspaces.com/${data.filePath}`;
                video.controls = true;
                addMediaElement(video, true)
            }

            if (fileType === "image/jpeg" || fileType === "image/png") {
                const img = document.createElement("img");
                img.src = `https://devjamin.fra1.cdn.digitaloceanspaces.com/${data.filePath}`;
                addMediaElement(img, false)
            }

            // More than 1 media, hide empty text
            if (mediaEl.children.length > 0) {
                mediaEmptyOverlay.style.display = "none";
            }
        } catch (error) {
            //console.error('Error:', error.message);
            alert(error.message);
        }
    }

    // Handle drop event
    mediaEl.addEventListener("drop", async function (e) {
        e.preventDefault();

        // Hide overlay
        mediaDraggingOverlay.style.display = "none";

        // Get dropped files
        const files = e.dataTransfer.files;

        // If no files, return
        if (files.length === 0) {
            return;
        }

        void handleFiles(files);
    });

    // Handle media upload via button
    addMediaBtn.onclick = function () {
        mediaInput.click();
    };
    mediaInput.onchange = async function () {
        const files = mediaInput.files;
        void handleFiles(files);
    };
</script>