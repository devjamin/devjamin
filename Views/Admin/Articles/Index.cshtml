@model devjamin.Models.AllArticlesCardViewModel

@{
    ViewData["Title"] = "Articles";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    @* Highlight active nav link *@
    #articleNavItem a,
    #articleNavItem svg {
        color: #160042;
        fill: #160042;
    }
</style>

<div class="top">
    <h1 class="top__title">Articles</h1>
    <a class="top__createBtn" href="/Admin/Articles/Create">Create Article</a>
</div>

@if (Model.PublishedArticles.Count == 0 && Model.NonPublishedArticles.Count == 0)
{
    <p class="articles__title">No articles found</p>
}
else
{
    @if (Model.PublishedArticles.Count != 0)
    {
        <section id="activeArticles" class="articles">
            <h2 class="articles__title">Published articles</h2>
            <div class="articles__container">
                @foreach (var articleCard in Model.PublishedArticles)
                {
                    <article class="article">
                        <a class="article__editLink" href="/Admin/Articles/Edit/@articleCard.ArticleId">
                            <svg width="24px" height="24px" clip-rule="evenodd" fill-rule="evenodd" stroke-linejoin="round"
                                stroke-miterlimit="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path
                                    d="m11.239 15.533c-1.045 3.004-1.238 3.451-1.238 3.84 0 .441.385.627.627.627.272 0 1.108-.301 3.829-1.249zm.888-.888 3.22 3.22 6.408-6.401c.163-.163.245-.376.245-.591 0-.213-.082-.427-.245-.591-.58-.579-1.458-1.457-2.039-2.036-.163-.163-.377-.245-.591-.245-.213 0-.428.082-.592.245zm-3.127-.895c0-.402-.356-.75-.75-.75-2.561 0-2.939 0-5.5 0-.394 0-.75.348-.75.75s.356.75.75.75h5.5c.394 0 .75-.348.75-.75zm5-3c0-.402-.356-.75-.75-.75-2.561 0-7.939 0-10.5 0-.394 0-.75.348-.75.75s.356.75.75.75h10.5c.394 0 .75-.348.75-.75zm0-3c0-.402-.356-.75-.75-.75-2.561 0-7.939 0-10.5 0-.394 0-.75.348-.75.75s.356.75.75.750h10.5c.394 0 .75-.348.75-.75zm0-3c0-.402-.356-.75-.75-.75-2.561 0-7.939 0-10.5 0-.394 0-.75.348-.75.75s.356.75.75.75h10.5c.394 0 .75-.348.75-.75z"
                                    fill-rule="nonzero" />
                            </svg>
                        </a>
                        @if (articleCard.CoverImagePath != null)
                        {
                            <img class="article__img" src="https://cdn.devjamin.com/@articleCard.CoverImagePath/w=768,format=auto" alt="@articleCard.Title">
                        }
                        else
                        {
                            <div class="article__noImg"></div>
                        }
                        <ul class="article__tags">
                            @if (articleCard.Tags.Count > 0)
                            {
                                @foreach (var tag in articleCard.Tags)
                                {
                                    <li class="article__tag">@tag.Name</li>
                                }
                            }
                            else {
                                <li class="article__tag">Uncategorized</li>
                            }
                        </ul>
                        <a class="article__goToLink" target="_blank" href="/Article/@articleCard.Slug">
                            <h3 class="article__title">@articleCard.Title</h3>
                        </a>
                        <p class="article__description">@articleCard.Description</p>
                    </article>
                }
            </div>
        </section>
    }
    @if (Model.NonPublishedArticles.Count != 0)
    {
        <section id="nonActiveArticles" class="articles">
            <h2 class="articles__title">Non-published articles</h2>
            <div class="articles__container">
                @foreach (var articleCard in Model.NonPublishedArticles)
                {
                    <article class="article">
                        <a class="article__editLink" href="/Admin/Articles/Edit/@articleCard.ArticleId">
                            <svg width="24px" height="24px" clip-rule="evenodd" fill-rule="evenodd" stroke-linejoin="round"
                                stroke-miterlimit="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path
                                    d="m11.239 15.533c-1.045 3.004-1.238 3.451-1.238 3.84 0 .441.385.627.627.627.272 0 1.108-.301 3.829-1.249zm.888-.888 3.22 3.22 6.408-6.401c.163-.163.245-.376.245-.591 0-.213-.082-.427-.245-.591-.58-.579-1.458-1.457-2.039-2.036-.163-.163-.377-.245-.591-.245-.213 0-.428.082-.592.245zm-3.127-.895c0-.402-.356-.75-.75-.75-2.561 0-2.939 0-5.5 0-.394 0-.75.348-.75.75s.356.75.75.75h5.5c.394 0 .75-.348.75-.75zm5-3c0-.402-.356-.75-.75-.75-2.561 0-7.939 0-10.5 0-.394 0-.75.348-.75.75s.356.75.75.75h10.5c.394 0 .75-.348.75-.75zm0-3c0-.402-.356-.75-.75-.75-2.561 0-7.939 0-10.5 0-.394 0-.75.348-.75.75s.356.75.75.750h10.5c.394 0 .75-.348.75-.75zm0-3c0-.402-.356-.75-.75-.75-2.561 0-7.939 0-10.5 0-.394 0-.75.348-.75.75s.356.75.75.75h10.5c.394 0 .75-.348.75-.75z"
                                    fill-rule="nonzero" />
                            </svg>
                        </a>
                        @if (articleCard.CoverImagePath != null)
                        {
                            <img class="article__img" src="https://cdn.devjamin.com/@articleCard.CoverImagePath/w=768,format=auto" alt="@articleCard.Title">
                        }
                        else
                        {
                            <div class="article__noImg"></div>
                        }
                        <ul class="article__tags">
                            @if (articleCard.Tags.Count > 0)
                            {
                                @foreach (var tag in articleCard.Tags)
                                {
                                    <li class="article__tag">@tag.Name</li>
                                }
                            }
                            else {
                                <li class="article__tag">Uncategorized</li>
                            }
                        </ul>
                        <a class="article__goToLink" target="_blank" href="/Article/@articleCard.Slug">
                            <h3 class="article__title">@articleCard.Title</h3>
                        </a>
                        <p class="article__description">@articleCard.Description</p>
                    </article>
                }
            </div>
        </section>
    }
}
