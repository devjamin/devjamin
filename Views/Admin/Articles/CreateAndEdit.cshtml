@model devjamin.Models.ArticleCreateEditViewModel
@{
    ViewData["Title"] = Model.Method == devjamin.Models.ArticleCreateEditMethodViewModel.Create ? "Create Article" : "Edit Article";
    var formAction = Model.Method == devjamin.Models.ArticleCreateEditMethodViewModel.Create ? "Create" : "Edit";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@* Quill library (WYSIWYG-editor) *@
<link href="~/lib/quill@2.0.0-rc.3/quill.snow.css" rel="stylesheet" asp-append-version="true" />
<script src="~/lib/quill@2.0.0-rc.3/quill.js" asp-append-version="true"></script>
@* Choices.js (Select) *@
<link rel="stylesheet" href="~/lib/choices.js/choices.min.css" asp-append-version="true">
<script src="~/lib/choices.js/choices.min.js" asp-append-version="true"></script>
@* Fancyapps (Carousel) *@
<link rel="stylesheet" href="~/lib/fancyapps/fancyapps.bundle.css" asp-append-version="true">
<script src="~/lib/fancyapps/fancyapps.bundle.js" asp-append-version="true"></script>
@* Our JS *@
<script src="~/js/articleCreateEdit.js" asp-append-version="true" defer></script>
<script src="~/js/articleMedia.js" asp-append-version="true" defer></script>

<style>
    @* Highlight active nav link *@
    #articleNavItem a,
    #articleNavItem svg {
        color: #160042;
        fill: #160042;
    }
</style>

<!-- Custom context menu for carousel control -->
<div id="carouselContextMenu" class="custom-context-menu">
    <ul>
        <li id="editCarouselAltText">Edit Alt Text</li>
        <li id="moveLeft">Move Left</li>
        <li id="moveRight">Move Right</li>
        <li id="removeImage">Remove Image</li>
    </ul>
</div>

<!-- Custom context menu for image alt text -->
<div id="imageContextMenu" class="custom-context-menu">
    <ul>
        <li id="editAltText">Edit Alt Text</li>
        <li id="removeImageSingle">Remove Image</li>
    </ul>
</div>

<!-- Custom context menu for table cells -->
<div id="tableContextMenu" class="custom-context-menu">
    <ul>
        <li id="tableInsertRowAbove">Insert row above</li>
        <li id="tableInsertRowBelow">Insert row below</li>
        <li id="tableInsertColLeft">Insert column left</li>
        <li id="tableInsertColRight">Insert column right</li>
        <li id="tableDeleteRow">Delete row</li>
        <li id="tableDeleteCol">Delete column</li>
        <li id="tableDeleteTable">Delete table</li>
    </ul>
</div>

<!-- Row/col size picker for the table toolbar button -->
<div id="tableSizePicker" class="tableSizePicker" style="display:none;">
    <div class="tableSizePicker__grid"></div>
    <div class="tableSizePicker__label">3 × 3</div>
</div>

<!-- Alt text edit modal -->
<div id="altTextModal" class="altTextModal" style="display: none;">
    <div class="altTextModal__content">
        <h3 class="altTextModal__title">Edit Alt Text</h3>
        <label for="altTextInput" class="altTextModal__label">Alt text (describe the image for accessibility):</label>
        <input type="text" id="altTextInput" class="altTextModal__input" placeholder="Describe what's in the image..." maxlength="125">
        <div class="altTextModal__buttons">
            <button id="saveAltText" type="button" class="altTextModal__button altTextModal__button--primary">Save</button>
            <button id="cancelAltText" type="button" class="altTextModal__button altTextModal__button--secondary">Cancel</button>
        </div>
    </div>
</div>

<h1 class="ceTitle">@ViewData["Title"]</h1>

@* Article editor form *@
<form class="ceForm" asp-action="@formAction" method="post">
    <input type="hidden" id="ArticleId" name="ArticleId" value="@Model.ArticleId" />
    <div class="ceForm__groupContainer">
        <div class="ceForm__group">
            <label class="ceForm__label" for="Title">Title</label>
            <input class="ceForm__input" type="text" placeholder="Title" value="@Model.Title" id="Title" name="Title">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState["Title"]?.Errors.Count > 0)
            {
                <span class="ceForm__error" asp-validation-for="Title"></span>
            }
        </div>
        <div class="ceForm__group">
            <label class="ceForm__label" for="Slug">Slug</label>
            <input tabindex="-1" class="ceForm__input" type="text" placeholder="Slug" value="@Model.Slug" id="Slug" name="Slug">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState["Slug"]?.Errors.Count > 0)
            {
                <span class="ceForm__error" asp-validation-for="Slug"></span>
            }
        </div>
    </div>
    <div class="ceForm__group">
        <label class="ceForm__label" for="Description">Description</label>
        <textarea class="ceForm__textarea" id="Description" name="Description" cols="30" placeholder="Description"
            rows="10">@Model.Description</textarea>
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState["Description"]?.Errors.Count > 0)
        {
            <span class="ceForm__error" asp-validation-for="Description"></span>
        }
    </div>
    <div class="ceForm__group">
        <label class="ceForm__label" for="MetaDescription">Meta Description</label>
        <textarea class="ceForm__textarea ceForm__textarea--small" id="MetaDescription" name="MetaDescription" cols="20"
            placeholder="Meta description for search engines (max 160 characters)"
            maxlength="160" rows="2">@Model.MetaDescription</textarea>
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState["MetaDescription"]?.Errors.Count > 0)
        {
            <span class="ceForm__error" asp-validation-for="MetaDescription"></span>
        }
    </div>
    <div class="ceForm__group">
        <label class="ceForm__label" for="tags">Tags</label>
        <select class="ceForm__input" id="tags" name="SelectedTagIds" placeholder="Select tags" multiple></select>
    </div>
    <div class="ceForm__group">
        <label class="ceForm__label" for="SemanticHTML">Content</label>
        <div class="ceForm__editor" id="Editor">
            @Html.Raw(Model.QuillDelta)
        </div>
        <input class="ceForm__input ceForm__input--hidden" type="hidden" value="@Model.SemanticHTML" name="SemanticHTML"
            id="SemanticHTML">
        <input class="ceForm__input ceForm__input--hidden" type="hidden" value="@Model.QuillDelta" name="QuillDelta"
            id="QuillDelta">
    </div>
    <div class="ceForm__group">
        <div class="ceForm__mediaHeader">
            <p class="ceForm__mediaLabel">Media</p>
            <button class="ceForm__btn ceForm__btn--small" type="button" id="addMediaBtn">Add media</button>
        </div>
        <div class="ceForm__mediaContainer">
            <div class="ceForm__media" id="media">

            </div>
            <div class="ceForm__mediaOverlay ceForm__mediaOverlay--empty" id="mediaEmptyOverlay">
                <p>Empty...<br/>Add something by dragging or press "Add media"</p>
            </div>
            <div class="ceForm__mediaOverlay ceForm__mediaOverlay--dragging" id="mediaDraggingOverlay">
                <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24"><path d="M10 18v-10h-2.51l4.51-5.01 4.51 5.01h-2.51v10h-4zm-2 2h8v-10h5l-9-10-9 10h5v10zm11-1v3h-14v-3h-2v5h18v-5h-2z"/></svg>
            </div>
            <div class="ceForm__mediaOverlay ceForm__mediaOverlay--spinner" id="mediaLoadingOverlay">
                <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24"><path d="M23 12c0 1.042-.154 2.045-.425 3h-2.101c.335-.94.526-1.947.526-3 0-4.962-4.037-9-9-9-1.706 0-3.296.484-4.655 1.314l1.858 2.686h-6.994l2.152-7 1.849 2.673c1.684-1.049 3.659-1.673 5.79-1.673 6.074 0 11 4.925 11 11zm-6.354 7.692c-1.357.826-2.944 1.308-4.646 1.308-4.962 0-9-4.038-9-9 0-1.053.191-2.06.525-3h-2.1c-.271.955-.425 1.958-.425 3 0 6.075 4.925 11 11 11 2.127 0 4.099-.621 5.78-1.667l1.853 2.667 2.152-6.989h-6.994l1.855 2.681z"/></svg>
            </div>
        </div>
    </div>
    <div class="ceForm__bottom">
        <div class="ceForm__bottomCheckboxContainer">
            <input class="ceForm__bottomCheckbox" type="checkbox" name="IsPublished" id="IsPublished"
                @(Model.IsPublished == "on" ? "checked" : "")>
            <label class="ceForm__bottomLabel" for="IsPublished">Publish article</label>
        </div>
        <div class="ceForm__btnWrapper">
            @if (Model.Method == devjamin.Models.ArticleCreateEditMethodViewModel.Edit)
            {
            <a href="/Admin/Articles/Delete/@Model.ArticleId"
                onclick="return confirm('Are you sure you want to delete this article?');"
                class="ceForm__btn ceForm__btn--danger">Delete</a>
            }
            <button class="ceForm__btn">Save</button>
        </div>
    </div>
</form>

<script>
    document.addEventListener('DOMContentLoaded', function () {
    var tagsElement = document.getElementById('tags');
    var choices = new Choices(tagsElement, {
        removeItemButton: true,
        itemSelectText: '',
        searchPlaceholderValue: 'Search tags',
        shouldSort: false,
        searchEnabled: true,
        placeholder: true,
        placeholderValue: 'Select tags',
        noResultsText: 'No tags found',
        noChoicesText: 'No tags to choose from'
    });

    // Populate select with tags using available tags and check for selected IDs
    choices.setChoices(
        @Html.Raw(Json.Serialize(Model.AvailableTags.Select(tag => new {
            value = tag.TagId.ToString(),
            label = tag.Name,
            selected = Model.SelectedTagIds.Contains(tag.TagId) // Check if the ID is in the selected IDs list
        })))
    );
});

</script>

@* Hidden input for media upload *@
<input type="file" id="mediaInput" hidden/>
@* Hidden input for loading existing media *@
<input type="hidden" id="mediaInputExisting" name="mediaInputExisting" value='@Json.Serialize(Model.Media)' />
