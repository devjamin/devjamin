@model devjamin.Models.ArticleTagCreateEditViewModel
@{
    ViewData["Title"] = Model.Method == devjamin.Models.ArticleTagCreateEditMethodViewModel.Create ? "Create Tag" : "Edit Tag";
    var formAction = Model.Method == devjamin.Models.ArticleTagCreateEditMethodViewModel.Create ? "CreateTag" : "EditTag";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    @* Highlight active nav link *@
    #tagsNavItem a, #tagsNavItem svg {
        color: #160042;
        fill: #160042;
    }
</style>

<h1 class="ceTitle">@ViewData["Title"]</h1>

@* Tag editor form *@
<form class="ceForm ceForm--tags" asp-controller="Admin" asp-action="@formAction" method="post">
    <input type="hidden" id="TagId" name="TagId" value="@Model.TagId" />
    <div class="ceForm__groupContainer">
        <div class="ceForm__group">
            <label class="ceForm__label" for="Name">Name</label>
            <input class="ceForm__input" type="text" placeholder="Name" value="@Model.Name" id="Name" name="Name" maxlength="30">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState["Name"]?.Errors.Count > 0)
            {
                <span class="ceForm__error" asp-validation-for="Name"></span>
            }
        </div>
        <div class="ceForm__group">
            <label class="ceForm__label" for="Slug">Slug</label>
            <input tabindex="-1" class="ceForm__input" type="text" placeholder="Slug" value="@Model.Slug" id="Slug" name="Slug" maxlength="35">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState["Slug"]?.Errors.Count > 0)
            {
                <span class="ceForm__error" asp-validation-for="Slug"></span>
            }
        </div>
    </div>
    <div class="ceForm__group">
        <label class="ceForm__label" for="Description">Description</label>
        <textarea class="ceForm__textarea" id="Description" name="Description" cols="30" placeholder="Description" maxlength="255"
            rows="10">@Model.Description</textarea>
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState["Description"]?.Errors.Count > 0)
        {
            <span class="ceForm__error" asp-validation-for="Description"></span>
        }
    </div>
    <div class="ceForm__bottom">
        <div class="ceForm__btnWrapper">
            @if (Model.Method == devjamin.Models.ArticleTagCreateEditMethodViewModel.Edit)
            {
            <a href="/Admin/Tags/Delete/@Model.TagId"
                onclick="return confirm('Are you sure you want to delete this tag?');"
                class="ceForm__btn ceForm__btn--danger">Delete</a>
            }
            <button class="ceForm__btn">Save</button>
        </div>
    </div>
</form>

<script>
    // Generate URL-friendly slug from tag name
    document.getElementById('Name').addEventListener('input', function () {
        const name = this.value;
        const slug = name
            .replace(/[^a-zA-Z0-9]+/g, '-') // Replace any non-alphanumeric characters with a single hyphen
            .replace(/^-+|-+$/g, '') // Remove leading and trailing hyphens
            .trim(); // Remove any whitespace
        document.getElementById('Slug').value = slug;
    });

    // Remove validation errors on input
    document.addEventListener('DOMContentLoaded', function() {
        // Get all inputs and textareas
        const formInputs = document.querySelectorAll('.ceForm__input, .ceForm__textarea');
        
        formInputs.forEach(input => {
            input.addEventListener('input', function() {
                // Find the associated error span
                const errorSpan = this.nextElementSibling;
                if (errorSpan && errorSpan.classList.contains('ceForm__error')) {
                    // Remove the error span completely
                    errorSpan.remove();
                    // Remove validation error class if it exists
                    this.classList.remove('input-validation-error');
                }
            });
        });
    });
</script>