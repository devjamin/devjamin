@model devjamin.Models.BlogTagCreateEditViewModel
@{
    ViewData["Title"] = Model.Method == devjamin.Models.BlogTagCreateEditMethodViewModel.Create ? "Create Tag" : "Edit Tag";
    var formAction = Model.Method == devjamin.Models.BlogTagCreateEditMethodViewModel.Create ? "CreateTag" : "EditTag";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    @* Highlight active nav link *@
    #tagsNavItem a, #tagsNavItem svg {
        color: #160042;
        fill: #160042;
    }
</style>

<h1 class="ceTitle">@ViewData["Title"]</h1>

@* Tag editor form *@
<form class="ceForm ceForm--tags" asp-controller="Admin" asp-action="@formAction" method="post">
    <input type="hidden" id="BlogTagId" name="BlogTagId" value="@Model.BlogTagId" />
    <div class="ceForm__groupContainer">
        <div class="ceForm__group">
            <label class="ceForm__label" for="Name">Name</label>
            <input class="ceForm__input" type="text" placeholder="Name" value="@Model.Name" id="Name" name="Name" maxlength="30">
        </div>
        <div class="ceForm__group">
            <label class="ceForm__label" for="Slug">Slug</label>
            <input tabindex="-1" class="ceForm__input" type="text" placeholder="Slug" value="@Model.Slug" id="Slug" name="Slug" maxlength="35">
        </div>
    </div>
    <div class="ceForm__group">
        <label class="ceForm__label" for="Description">Description</label>
        <textarea class="ceForm__textarea" id="Description" name="Description" cols="30" placeholder="Description" maxlength="255"
            rows="10">@Model.Description</textarea>
    </div>
    <div class="ceForm__bottom">
        <div class="ceForm__btnWrapper">
            @if (Model.Method == devjamin.Models.BlogTagCreateEditMethodViewModel.Edit)
            {
            <a href="/Admin/Tags/Delete/@Model.BlogTagId"
                onclick="return confirm('Are you sure you want to delete this tag?');"
                class="ceForm__btn ceForm__btn--danger">Delete</a>
            }
            <button class="ceForm__btn">Save</button>
        </div>
    </div>
</form>

<script>
    // Generate URL-friendly slug from tag name
    document.getElementById('Name').addEventListener('input', function () {
        const name = this.value;
        const slug = name
            .replace(/[^a-zA-Z0-9]+/g, '-') // Replace any non-alphanumeric characters with a single hyphen
            .replace(/^-+|-+$/g, '') // Remove leading and trailing hyphens
            .trim(); // Remove any whitespace
        document.getElementById('Slug').value = slug;
    });
</script>