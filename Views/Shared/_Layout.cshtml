                    <rect x="55.933" y="86.28" width="60.711" height="61.434" style="stroke: rgb(0, 0, 0);"></rect>
                    <rect x="132.211" y="147.834" width="62.796" height="61.76" style="stroke: rgb(0, 0, 0);"></rect>
                    <rect x="24.859" y="217.944" width="61.46" height="62.314" style="stroke: rgb(0, 0, 0);"></rect>
                    <rect x="133.844" y="289.651" width="61.447" height="63.343" style="stroke: rgb(0, 0, 0);"></rect>
