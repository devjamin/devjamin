                    <rect class="rectClone" style="transform: translateY(-100%);" x="133.844" y="289.651" width="61.447" height="63.343" style="stroke: rgb(0, 0, 0);"></rect>
                    <rect class="rectClone" style="transform: translateY(-100%);" x="55.138" y="351.067" width="62.913" height="63.507" style="stroke: rgb(0, 0, 0);"></rect>
