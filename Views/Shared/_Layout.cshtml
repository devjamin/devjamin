<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Devjamin</title>
    <meta name="description" content="@ViewData["MetaDescription"]">
    <link rel="icon" href="https://cdn.devjamin.com/0b53a686-ebc7-4fe3-a200-b84c4b11d300/public" type="image/png" sizes="128x128">
    <link rel="stylesheet" href="~/css/global.css" asp-append-version="true" />
    @if ((string)(ViewData["Title"] ?? string.Empty) == "Home")
    {
        <link rel="stylesheet" href="~/css/frontpage.css" asp-append-version="true"/>
    }
    <script src="~/js/global.js" asp-append-version="true" defer></script>
    <link rel="preload" href="~/fonts/Courier_Prime/CourierPrime-Regular.ttf" as="font" type="font/ttf" crossorigin="anonymous">
    <link rel="preload" href="~/fonts/Courier_Prime/CourierPrime-Bold.ttf" as="font" type="font/ttf" crossorigin="anonymous">
    <link rel="preload" href="~/fonts/Montserrat/Montserrat-Regular.ttf" as="font" type="font/ttf" crossorigin="anonymous">
    <link rel="preload" href="~/fonts/Montserrat/Montserrat-Medium.ttf" as="font" type="font/ttf" crossorigin="anonymous">
    <link rel="preconnect" href="https://cdn.devjamin.com">
    <script defer asp-append-version="true" src="https://analytics.devjamin.com/script.js" data-website-id="d46551d6-9e85-49d3-bd17-63fba4b37095"></script>
</head>

<body>
    <script>
        (() => {
            // Check dark mode preference or from local storage
            const darkModePreference = localStorage.getItem("darkMode");

            // Enable based on previous selection
            if (darkModePreference) {
                if (darkModePreference === "1") {
                    document.body.classList.add("dark");
                }
            } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.body.classList.add("dark");
                localStorage.setItem("darkMode", "1");
            }
        })();

        function toggleDarkMode() {
            const themeToggle = document.querySelector(".navigation__themeToggle");

            if (document.body.classList.contains("dark")) {
                document.body.classList.remove("dark");
                themeToggle.checked = false;
                localStorage.setItem("darkMode", "0");
            } else {
                document.body.classList.add("dark");
                themeToggle.checked = true;
                localStorage.setItem("darkMode", "1");
            }
        }
    </script>
    <div id="navigationMenuOpenOverlay"></div>
    <header>
