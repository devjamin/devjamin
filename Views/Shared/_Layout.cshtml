                </svg>
            </a>
            <ul class="navigation__list">
                <li class="navigation__item">
                    <a class="navigation__link" asp-controller="Public" asp-action="Index">Home</a>
                </li>
                <li class="navigation__item">
                    <a class="navigation__link" asp-controller="Public" asp-action="Articles">Articles</a>
                </li>
                <li class="navigation__item" id="mobileContact">
                    <a class="navigation__link" href="/#contact">Contact</a>
                </li>
            </ul>
            <label for="toggleTheme" class="navigation__themeToggleLabel">
                <input id="toggleTheme" class="navigation__themeToggle" type="checkbox" aria-label="Toggle light/dark mode">
            </label>
            <a class="navigation__contact" asp-controller="Home" asp-action="Index" asp-fragment="contact">Contact</a>
            <button id="menuToggle" class="navigation__menuToggle" title="Toggle navigation menu">
                <svg class="navigation__menuSvg">
                    <line x1="0" y1="50%" x2="100%" y2="50%" class="top" shape-rendering="crispEdges" />
                    <line x1="0" y1="50%" x2="100%" y2="50%" class="middle" shape-rendering="crispEdges" />
                    <line x1="0" y1="50%" x2="100%" y2="50%" class="bottom" shape-rendering="crispEdges" />
                </svg>
            </button>
        </nav>
    </header>
    <script>
        // Theme toggle
        const themeToggle = document.querySelector(".navigation__themeToggle");
        themeToggle.addEventListener("change", () => {
            toggleDarkMode();
        });
        if (document.body.classList.contains("dark")) {
            themeToggle.checked = true;
        }

        // Mobile contact
        // if on home page hide menu
        if (window.location.pathname === "/") {
            const mobileContact = document.getElementById("mobileContact");
            mobileContact.addEventListener("click", (e) => {
                e.preventDefault();
                navigation.closeMenu();
                setTimeout(() => {
                    // smooth scroll to contact
                    const contact = document.getElementById("contact");
                    contact.scrollIntoView({ behavior: "smooth" });
                }, 300);
            });
        }
    </script>
    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

