@{
    var path = Context.Request.Path.Value ?? "/";
    var isHome = path == "/";
    var isArticles = path.StartsWith("/Article", StringComparison.OrdinalIgnoreCase);
    // On the homepage section links stay in-page; elsewhere they point back to the homepage
    var homePrefix = isHome ? "" : "/";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Devjamin</title>
    <meta name="description" content="@ViewData["MetaDescription"]">
    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#141312" media="(prefers-color-scheme: dark)">
    <script>
        // Apply theme before first paint: stored choice (incl. legacy "darkMode" key), else system preference
        (function () {
            var t = null;
            try {
                t = localStorage.getItem("dj-theme");
                if (!t && localStorage.getItem("darkMode") !== null) t = localStorage.getItem("darkMode") === "1" ? "dark" : "light";
            } catch (e) { }
            if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            document.documentElement.dataset.theme = t;
        })();
    </script>
    <link rel="preconnect" href="https://cdn.devjamin.com">
    <link rel="icon" href="https://cdn.devjamin.com/0b53a686-ebc7-4fe3-a200-b84c4b11d300/public" type="image/png" sizes="128x128">
    <link rel="preload" href="~/fonts/Inter/Inter-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous">
    <link rel="preload" href="~/fonts/InterTight/InterTight-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <script defer asp-append-version="true" src="https://analytics.devjamin.com/script.js" data-website-id="d46551d6-9e85-49d3-bd17-63fba4b37095"></script>
</head>

<body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <symbol id="logo" viewBox="0 0 500 500">
            <g fill="currentColor">
                <rect x="117.5" y="1.7" width="84.7" height="84.8" /><rect x="55.9" y="86.3" width="60.7" height="61.4" /><rect x="132.2" y="147.8" width="62.8" height="61.8" /><rect x="24.9" y="217.9" width="61.5" height="62.3" /><rect x="133.8" y="289.7" width="61.4" height="63.3" /><rect x="55.1" y="351.1" width="62.9" height="63.5" /><rect x="118.4" y="411.4" width="85.4" height="87" />
                <path d="M227 267.5 L475.8 267.9 L226.1 498.5 Z M474.2 268.6 C483.7 266.1 453.1 440 321.6 477.6 C300 485 260 497 226.7 497.6 Z" />
                <path d="M226.9 0.8 L475.5 232.9 L226.2 233.1 Z M226.7 1.9 C367.9 -12.5 530.2 180.9 404.6 193.6 L475 233.3 Z" />
            </g>
        </symbol>
        <symbol id="arrow" viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></symbol>
    </svg>

    <header class="nav" id="nav">
        <div class="wrap nav__in">
            <a href="/" class="brand" aria-label="Devjamin home"><svg aria-hidden="true"><use href="#logo" /></svg>Devjamin</a>
            <nav class="nav__links" aria-label="Primary">
                <a href="@(homePrefix)#work">Work</a>
                <a href="/Articles" aria-current="@(isArticles ? "page" : null)">Articles</a>
                <a href="@(homePrefix)#stack">Stack</a>
                <a href="@(homePrefix)#experience">Experience</a>
                <a href="@(homePrefix)#contact">Contact</a>
            </nav>
            <div class="nav__tools">
                <button class="icon-btn" id="themeToggle" type="button" aria-label="Toggle color theme">
                    <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z" /></svg>
                    <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                </button>
                <button class="icon-btn menu-btn" id="menuToggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">
                    <svg class="i-menu" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
                    <svg class="i-close" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                </button>
            </div>
        </div>
        <nav class="nav__mobile" id="mobileNav" aria-label="Mobile">
            <a href="@(homePrefix)#work">Work</a>
            <a href="/Articles" aria-current="@(isArticles ? "page" : null)">Articles</a>
            <a href="@(homePrefix)#stack">Stack</a>
            <a href="@(homePrefix)#experience">Experience</a>
            <a href="@(homePrefix)#contact">Contact</a>
        </nav>
    </header>

    <main id="top">
        @RenderBody()
    </main>

    <footer class="foot">
        <div class="wrap">
            <a href="/" class="brand" aria-label="Devjamin home"><svg aria-hidden="true"><use href="#logo" /></svg>&copy; @DateTime.Now.Year Devjamin</a>
            <nav class="foot__links" aria-label="Footer">
                <a href="/Articles">Articles</a>
                @* Email is XOR-encoded and decoded by site.js on load, keeping it out of the HTML for scrapers *@
                <a href="#" data-email="5a3935342e3b392e1a3e3f2c303b37333474393537" data-email-keep-text>Email</a>
                <a href="https://github.com/devjamin" target="_blank" rel="noopener">GitHub</a>
            </nav>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
