@model ErrorViewModel
@{
    var notFound = Model.StatusCode == 404;
    ViewData["Title"] = notFound ? "Page not found" : "Something went wrong";
    ViewData["MetaDescription"] = ViewData["Title"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="page-head error-page">
    <div class="wrap">
        <span class="error-code">@Model.StatusCode</span>
        @if (notFound)
        {
            <h1 class="display">Lost the thread<span class="dot-accent">.</span></h1>
            <p>This page doesn't exist, or it moved somewhere else. Let's get you back on track.</p>
        }
        else
        {
            <h1 class="display">Something broke<span class="dot-accent">.</span></h1>
            <p>That one's on me. Try again in a moment, and if it keeps happening, let me know.</p>
        }
        <div class="hero__cta">
            <a class="btn btn--fill" href="/">Back home</a>
            <a class="btn btn--quiet" href="/Articles">Read articles <svg aria-hidden="true"><use href="#arrow" /></svg></a>
        </div>
        @if (!notFound && Model.ShowRequestId)
        {
            <p class="eyebrow" style="margin-top:40px">Request ID: <code>@Model.RequestId</code></p>
        }
    </div>
</section>
