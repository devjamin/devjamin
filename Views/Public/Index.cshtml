@model IEnumerable<devjamin.Models.ArticleCardViewModel>
@{
    ViewData["Title"] = "Frontend Developer with Full-Stack and Infrastructure Experience";
    ViewData["MetaDescription"] = "Welcome to my portfolio and articles – I'm sharing my experience as a frontend developer along with personal projects and DIY builds.";
    Layout = "~/Views/Shared/_Layout.cshtml";
    const string cdn = "https://cdn.devjamin.com/";
    var articles = Model.ToList();
    var featured = articles.FirstOrDefault();
}

@section Scripts {
    <script src="~/lib/gsap/gsap.min.js" asp-append-version="true" defer></script>
    <script src="~/lib/gsap/ScrollTrigger.min.js" asp-append-version="true" defer></script>
    <script src="~/lib/gsap/Draggable.min.js" asp-append-version="true" defer></script>
    <script src="~/js/home.js" asp-append-version="true" defer></script>
}

@* Structured Data for SEO *@
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@graph": [
    {
      "@@type": "WebSite",
      "@@id": "https://www.devjamin.com/#website",
      "url": "https://www.devjamin.com",
      "name": "Devjamin - Frontend Developer Portfolio & Articles",
      "description": "Welcome to my portfolio and articles – I'm sharing my experience as a frontend developer along with personal projects and DIY builds.",
      "publisher": {
        "@@id": "https://www.devjamin.com"
      },
      "inLanguage": "en-US"
    },
    {
      "@@type": "Person",
      "@@id": "https://www.devjamin.com/#person",
      "name": "Devjamin",
      "url": "https://www.devjamin.com",
      "image": "@(cdn + "78840034-0447-49ca-b65d-04370e46ac00/w=800,format=auto")",
      "description": "Frontend-Focused Full-Stack Developer",
      "jobTitle": "Frontend Developer",
      "worksFor": {
        "@@type": "Organization",
        "name": "Major Online Retailer"
      },
      "alumniOf": {
        "@@type": "EducationalOrganization",
        "name": "Technical College",
        "description": "Web Developer Education"
      },
      "knowsAbout": ["Frontend Development", "React", "JavaScript", "Git", "Version Control", "CI/CD", "API Development", "UI/UX Design", "System Administration"],
      "mainEntityOfPage": {
        "@@type": "WebPage",
        "@@id": "https://www.devjamin.com"
      }
    },
    {
      "@@type": "Blog",
      "@@id": "https://www.devjamin.com/#articles",
      "url": "https://www.devjamin.com/Articles",
      "name": "Devjamin Articles",
      "description": "Insights and tutorials about frontend development, programming, and DIY projects",
      "inLanguage": "en-US",
      "author": {
        "@@id": "https://www.devjamin.com/#person"
      },
      "publisher": {
        "@@id": "https://www.devjamin.com/#person"
      }
    }
  ]
}
</script>

@* HERO *@
<section class="hero" id="hero">
    <div class="wrap hero__grid">
        <div class="hero__txt">
            <p class="eyebrow h-in">Frontend-Focused Full-Stack Developer</p>
            <h1 class="display h-in">Building complex things one bit at a time<span class="dot-accent">.</span></h1>
            <p class="hero__sub h-in">Tinkering, improving, iterating.</p>
            <p class="hero__lead h-in">Building frontends for a high-traffic e-commerce platform.</p>
            <div class="hero__cta h-in">
                <a class="btn btn--fill" href="#work">See the work</a>
                <a class="btn btn--quiet" href="#contact">Say hi <svg aria-hidden="true"><use href="#arrow" /></svg></a>
            </div>
        </div>

        <div class="hero__art">
            <div class="pzone" id="pzone">
                <span class="pzone__bg" aria-hidden="true"></span>
                <figure class="portrait">
                    <img src="@(cdn)78840034-0447-49ca-b65d-04370e46ac00/w=620,format=auto"
                         srcset="@(cdn)78840034-0447-49ca-b65d-04370e46ac00/w=310,format=auto 310w, @(cdn)78840034-0447-49ca-b65d-04370e46ac00/w=620,format=auto 620w, @(cdn)78840034-0447-49ca-b65d-04370e46ac00/w=1080,format=auto 1080w"
                         sizes="(max-width: 900px) 60vw, 290px" alt="Portrait of Devjamin" width="620" height="775" fetchpriority="high">
                </figure>
                <span class="me-note" aria-hidden="true">that's me →</span>

                <span class="sticker s1" title="Drag me"><img src="~/img/tech/react.svg" alt="">React</span>
                <span class="sticker s2" title="Drag me"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5.5" cy="16" r="3.5" /><circle cx="18.5" cy="16" r="3.5" /><path d="M5.5 16 9 9h6.5l3 7M9 9l3.5 7H5.5M14 5.5h2.5l-1 3.5" /></svg>e-bikes</span>
                <span class="sticker s3" title="Drag me"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 10.5 12 3.5l8.5 7V20a.5.5 0 0 1-.5.5h-5v-6h-6v6H4a.5.5 0 0 1-.5-.5z" /></svg>Home Assistant</span>
                <span class="sticker sticker--accent s4" title="Drag me"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 11h13v3.5a5 5 0 0 1-5 5h-3a5 5 0 0 1-5-5z" /><path d="M17.5 12.5h3M8.5 8c0-1 1-1.3 1-2.3S8.5 4.5 8.5 4.5M12.5 8c0-1 1-1.3 1-2.3s-1-1.2-1-1.2" /></svg>cooking</span>
                <span class="sticker s5" title="Drag me"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2" /><path d="M10 3.5V7M14 3.5V7M10 17v3.5M14 17v3.5M3.5 10H7M3.5 14H7M17 10h3.5M17 14h3.5" /></svg>IoT</span>
            </div>
            <p class="drag-hint" aria-hidden="true">Stickers are draggable · double-click to put one back</p>
        </div>
    </div>
</section>

@* PROJECTS *@
<section class="sec sec--alt" id="work">
    <div class="wrap">
        <div class="sh">
            <p class="eyebrow">Projects</p>
            <h2 class="display">Work<span class="dot-accent">.</span></h2>
            <p>Things I've designed, built and shipped, and one that's still brewing.</p>
            <div class="carousel-meta" aria-hidden="true"><span id="workCount">01 / 03</span><span class="carousel-meta__bar"><i id="workBar"></i></span></div>
        </div>

        <div class="projects">
            <article class="pcard">
                <div class="pcard__txt">
                    <div>
                        <span class="pill"><i></i>Live · Multiplayer game</span>
                        <h3 class="display">Battleships.io</h3>
                    </div>
                    <div class="pcard__desc">
                        <p>A twist on the classic Battleship game. Both players fire simultaneously in time-based ranked matches.</p>
                        <a class="link" href="https://battleships.io" target="_blank" rel="noopener">Play now <svg aria-hidden="true"><use href="#arrow" /></svg></a>
                    </div>
                    <ul class="feat"><li>Real-time multiplayer</li><li>Socket.IO</li><li>Node.js + PostgreSQL</li><li>OAuth (Google &amp; Discord)</li><li>Dockerized</li></ul>
                </div>
                <div class="pcard__media">
                    <img src="@(cdn)5ba1cbea-8a2f-4873-61a6-ca455c634a00/w=1200,format=auto" alt="Battleships.io gameplay screenshot" width="1200" height="675" loading="lazy">
                </div>
            </article>

            <article class="pcard">
                <div class="pcard__txt">
                    <div>
                        <span class="pill">Custom CMS &amp; blog</span>
                        <h3 class="display">This Website</h3>
                    </div>
                    <div class="pcard__desc">
                        <p>The site you're on, built from scratch with a custom CMS behind it. I write, edit and publish articles through my own admin panel, with image uploads, SEO-friendly URLs and a contact form that holds up against spam.</p>
                        <a class="link" href="https://github.com/devjamin" target="_blank" rel="noopener">View on GitHub <svg aria-hidden="true"><use href="#arrow" /></svg></a>
                    </div>
                    <ul class="feat"><li>ASP.NET Core 8 MVC</li><li>EF Core + MariaDB</li><li>Rich-text editor (Quill)</li><li>Cloudflare Images CDN</li><li>Rate limiting &amp; spam protection</li></ul>
                </div>
                @* TODO: swap the mock for a real screenshot of the admin editor *@
                <div class="pcard__media" aria-hidden="true">
                    <div class="mock">
                        <div class="mock__bar"><i></i><i></i><i></i><span>devjamin.com/admin</span></div>
                        <div class="mock__body">
                            <div class="mock__side"><b></b><b></b><b style="width:80%"></b><b style="width:60%"></b><b></b></div>
                            <div class="mock__main">
                                <div class="mock__tools"><b></b><b></b><b></b><b></b><b></b></div>
                                <div class="mock__h"></div>
                                <div class="mock__p"></div><div class="mock__p" style="width:92%"></div><div class="mock__p" style="width:75%"></div>
                                <div class="mock__img"><svg><use href="#logo" /></svg></div>
                            </div>
                        </div>
                    </div>
                </div>
            </article>

            <article class="pcard pcard--soon">
                <div class="pcard__txt">
                    <div>
                        <span class="pill"><i></i>Coming soon · AI game generator</span>
                        <h3 class="display">Gamebrew.ai</h3>
                    </div>
                    <div class="pcard__desc">
                        <p>Describe a game, and play it in your browser minutes later. Behind the scenes, multi-step AI agent workflows plan, build and refine each game.</p>
                    </div>
                    <ul class="feat"><li>AI agent workflows</li><li>Playable browser games</li></ul>
                    <p class="soon-note">Still brewing. No link yet.</p>
                </div>
                <div class="brew" aria-hidden="true">
                    <svg viewBox="0 0 120 124">
                        <path d="M44 12h32" />
                        <path d="M50 12v36a32 32 0 1 0 20 0V12" />
                        <path class="liquid" d="M29 86c6-4 12-4 18 0s12 4 18 0 12-4 18 0 7 3 8 2" />
                        <circle cx="50" cy="100" r="2.2" />
                        <circle cx="66" cy="104" r="1.6" />
                        <circle cx="60" cy="95" r="1.4" />
                        <circle class="bubble" cx="60" cy="80" r="3.4" />
                        <path d="M34 120h52" opacity=".4" />
                    </svg>
                </div>
            </article>
        </div>
    </div>
</section>

@* ARTICLES *@
<section class="sec" id="writing">
    <div class="wrap">
        <div class="sh">
            <p class="eyebrow">Articles</p>
            <h2 class="display">Writing<span class="dot-accent">.</span></h2>
        </div>

        @if (featured == null)
        {
            <p class="empty">No articles yet. The first one is on its way.</p>
        }
        else
        {
            <a class="feature" href="/Article/@featured.Slug">
                <div class="feature__img">
                    @if (featured.CoverImagePath != null)
                    {
                        <img src="@(cdn)@featured.CoverImagePath/w=900,format=auto" alt="" loading="lazy">
                    }
                </div>
                <div class="feature__txt">
                    <span class="tags eyebrow">
                        @foreach (var tag in featured.Tags.DefaultIfEmpty(new ArticleTagViewModel { Name = "Uncategorized" }))
                        {
                            <span>@tag.Name</span>
                        }
                    </span>
                    <h3>@featured.Title</h3>
                    <p>@featured.Description</p>
                    <span class="link">Read article <svg aria-hidden="true"><use href="#arrow" /></svg></span>
                </div>
            </a>

            @if (articles.Count > 1)
            {
                <div class="acards">
                    @foreach (var article in articles.Skip(1))
                    {
                        <partial name="~/Views/Public/_ArticleCard.cshtml" model="article" />
                    }
                </div>
            }
        }
        <p class="more"><a class="link" href="/Articles">All articles <svg aria-hidden="true"><use href="#arrow" /></svg></a></p>
    </div>
</section>

