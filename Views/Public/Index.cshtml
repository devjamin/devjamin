@model IEnumerable<devjamin.Models.BlogPostCardViewModel>
@{
    ViewData["Title"] = "Frontend Developer and DIY Enthusiast";
    ViewData["MetaDescription"] = "Welcome to my portfolio and blog – I'm sharing my experience as a frontend developer along with personal projects and DIY builds.";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var CDNBASEPATH = ViewData["CDNBASEPATH"];
}

@* Structured Data for SEO *@
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@graph": [
    {
      "@@type": "WebSite",
      "@@id": "https://www.devjamin.com/#website",
      "url": "https://www.devjamin.com",
      "name": "Devjamin - Frontend Developer Portfolio & Blog",
      "description": "Welcome to my portfolio and blog – I'm sharing my experience as a frontend developer along with personal projects and DIY builds.",
      "publisher": {
        "@@id": "https://www.devjamin.com"
      },
      "inLanguage": "en-US"
    },
    {
      "@@type": "Person",
      "@@id": "https://www.devjamin.com/#person",
      "name": "Devjamin",
      "url": "https://www.devjamin.com",
      "image": "@(CDNBASEPATH + "5fcecd76-25ef-4b59-3798-e59ba5e53400/w=800,format=auto")",
      "description": "Frontend developer and DIY enthusiast building complex things one bit at a time",
      "jobTitle": "Frontend Developer",
      "worksFor": {
        "@@type": "Organization",
        "name": "Major Online Retailer"
      },
      "alumniOf": {
        "@@type": "EducationalOrganization",
        "name": "Technical College",
        "description": "Web Developer Education"
      },
      "knowsAbout": ["Frontend Development", "React", "JavaScript", "Git", "Version Control", "CI/CD", "API Development", "UI/UX Design", "System Administration"],
      "mainEntityOfPage": {
        "@@type": "WebPage",
        "@@id": "https://www.devjamin.com"
      }
    },
    {
      "@@type": "Blog",
      "@@id": "https://www.devjamin.com/#blog",
      "url": "https://www.devjamin.com/Blogs",
      "name": "Devjamin Blog",
      "description": "Insights and tutorials about frontend development, programming, and DIY projects",
      "inLanguage": "en-US",
      "author": {
        "@@id": "https://www.devjamin.com/#person"
      },
      "publisher": {
        "@@id": "https://www.devjamin.com/#person"
      }
    }
  ]
}
</script>

<section class="sectionWrapper hero">
    <div class="hero__infoBox">
        <p class="hero__name">Devjamin</p>
        <h1 class="hero__title">Frontend-developer and DIY enthusiast</h1>
        <p class="hero__description">
            <span id="typewriter-text">Building complex things one bit at a time</span><span class="typewriter-cursor">|</span>
        </p>
        <div class="hero__cta">
            <form class="hero__form" novalidate autocomplete="off">
                <input name="email" class="hero__input" id="email" type="email" placeholder="Enter Email" autocomplete="off"/>
                <button class="hero__contact">Contact</button>
            </form>
            <a class="hero__more" asp-controller="Home" asp-action="Index" asp-fragment="experience">Learn more</a>
        </div>
    </div>
    <div class="hero__imgBox">
        <img class="hero__img" 
             fetchPriority="high" 
             src="https://cdn.devjamin.com/5fcecd76-25ef-4b59-3798-e59ba5e53400/w=540,format=auto" 
             srcset="https://cdn.devjamin.com/5fcecd76-25ef-4b59-3798-e59ba5e53400/w=310,format=auto?v=1 310w,
                     https://cdn.devjamin.com/5fcecd76-25ef-4b59-3798-e59ba5e53400/w=620,format=auto?v=2 620w,
                     https://cdn.devjamin.com/5fcecd76-25ef-4b59-3798-e59ba5e53400/w=540,format=auto?v=3 540w,
                     https://cdn.devjamin.com/5fcecd76-25ef-4b59-3798-e59ba5e53400/w=1080,format=auto?v=4 1080w"
             sizes="(max-width: 768px) 310px,
                    540px"
            width="500"
            height="500"
            alt="Portrait of devjamin">
    </div>
</section>
<div id="blogs" class="sectionContrastWrapper">
    <section class="sectionWrapper blogs">
        <p class="blogs__tag">Devjamin Insights</p>
        <h2 class="blogs__title">Check Out My Latest Blogs</h2>
        <div class="blogs__wrapper">
            <button id="blogsContainerArrowLeft" class="blogs__containerArrow">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M16.67 0l2.83 2.829-9.339 9.175 9.339 9.167-2.83 2.829-12.17-11.996z"/></svg>
            </button>
            <button id="blogsContainerArrowRight" class="blogs__containerArrow blogs__containerArrow--right">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M7.33 24l-2.83-2.829 9.339-9.175-9.339-9.167 2.83-2.829 12.17 11.996z"/></svg>
            </button>
            <div class="blogs__container">
                @foreach (var blogCard in Model)
                {
                    <article class="blog">
                        <a class="blog__anchor" href="/Blog/@blogCard.Slug">
                            @if (blogCard.CoverImagePath != null)
                            {
                                <img class="blog__img" src="https://cdn.devjamin.com/@blogCard.CoverImagePath/w=768,format=auto" alt="@blogCard.Title">
                            }
                            else
                            {
                                <div class="blog__noImg"></div>
                            }
                            <ul class="blog__tags">
                                @if (blogCard.Tags.Count > 0)
                                {
                                    @foreach (var tag in blogCard.Tags)
                                    {
                                        <li class="blog__tag">@tag.Name</li>
                                    }
                                }
                                else {
                                    <li class="blog__tag">Uncategorized</li>
                                }
                            </ul>
                            <h3 class="blog__title">@blogCard.Title</h3>
                            <p class="blog__description">@blogCard.Description</p>
                        </a>
                    </article>
                }
            </div>
        </div>
        <a class="blogs__more" href="/Blogs">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="blogs__moreText">
                See All Blogs
            </span>
        </a>
    </section>
</div>
<section id="projects" class="sectionWrapper projects">
    <p class="projects__tag">Personal Projects</p>
    <h2 class="projects__title">Things I've Built</h2>
    <p class="projects__description">A collection of side-projects I actually managed to finish.</p>
    <div class="projects__grid">
        <article class="projectShowcase">
            <a class="projectShowcase__media" href="https://battleships.io" target="_blank" rel="noopener noreferrer" aria-label="Open Battleships.io screenshot">
                <img class="projectShowcase__img" src="https://cdn.devjamin.com/5ba1cbea-8a2f-4873-61a6-ca455c634a00/w=900,format=auto" alt="Screenshot of Battleships.io" width="600" height="600" loading="lazy">
            </a>
            <div class="projectShowcase__body">
                <p class="projectShowcase__eyebrow">Live Multiplayer Game</p>
                <h3 class="projectShowcase__title">Battleships.io</h3>
                <p class="projectShowcase__description">A twist on the classic Battleship game. Both players fire simultaneously in time-based ranked matches.</p>
                <ul class="projectShowcase__features">
                    <li class="projectFeature">
                        <svg class="projectFeature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                        Real-time multiplayer
                    </li>
                    <li class="projectFeature">
                        <svg class="projectFeature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                        </svg>
                        Socket.IO
                    </li>
                    <li class="projectFeature">
                        <svg class="projectFeature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
                        </svg>
                        Node.js + PostgreSQL
                    </li>
                    <li class="projectFeature">
                        <svg class="projectFeature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>
                        </svg>
                        OAuth (Google &amp; Discord)
                    </li>
                    <li class="projectFeature">
                        <svg class="projectFeature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>
                        </svg>
                        Dockerized
                    </li>
                </ul>
                <a class="projectShowcase__cta" href="https://battleships.io" target="_blank" rel="noopener noreferrer">
                    Play now
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            </div>
        </article>
    </div>
</section>
