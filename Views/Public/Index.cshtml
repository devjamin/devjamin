        <form class="contact__form" asp-action="">
            <label class="contact__label" for="name">Name</label>
            <input class="contact__input" id="name" name="name" type="text" placeholder="Name" />
            <label class="contact__label" for="email">Email</label>
            <input class="contact__input" novalidate type="email" id="email" name="email" type="text"
                placeholder="Email" />
            <label class="contact__label" for="message">Message</label>
            <textarea class="contact__textarea" id="message" name="message" cols="30" rows="10"
                placeholder="Message"></textarea>
            <button class="contact__btn">Send</button>
        </form>
