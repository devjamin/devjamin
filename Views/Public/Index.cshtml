                <path
                    d="M15.5288 4.34702C15.6515 4.10161 16.002 4.10161 16.1247 4.34702C16.7534 5.60358 16.8889 5.73891 18.1458 6.36701C18.3914 6.48971 18.3914 6.83993 18.1458 6.96263C16.8889 7.59073 16.7534 7.72606 16.1247 8.98262C16.002 9.22803 15.6515 9.22803 15.5288 8.98262C14.9001 7.72606 14.7646 7.59073 13.5077 6.96263C13.2621 6.83993 13.2621 6.48971 13.5077 6.36701C14.7646 5.73891 14.9001 5.60358 15.5288 4.34702Z" />
            </svg>
            See All Articles
        </a>
    </section>
</div>
<section id="experience" class="sectionWrapper experience">
    <h2 class="experience__title">Experience</h2>
    <p class="experience__description">So much experience for such a young guy huh</p>
    <ul class="timeline">
        <li class="timeline__item">
            <div class="timeline__date">
                <p class="timeline__dateTxt">2022-present</p>
                <div class="timeline__dot"></div>
            </div>
            <div class="timeline__card">
                <h3>Frontend Developer - AndLight</h3>
                <ul>
                    <li>
                        Started as an intern and was later hired as a Junior Frontend Developer (part-time) while studying.
                    </li>
                    <li>
                        Transitioned to a <b>full-time Frontend Developer</b> role in <b>August 2023</b> after graduating.
                    </li>
                    <li>
                        Today, <b>I lead frontend development</b> while also handling <b>system administration and maintaining self-hosted infrastructure</b>.
                    </li>
                </ul>
            </div>
        </li>
        <li class="timeline__item">
            <div class="timeline__date">
                <p class="timeline__dateTxt">2021-2023</p>
                <div class="timeline__dot"></div>
            </div>
            <div class="timeline__card">
                <h3>Web Developer Education - NEXT & Roskilde Tekniske Skole</h3>
                <ul>
                    <li>
                        Built a strong foundation in <b>frontend and backend development</b>.
                    </li>
                    <li>
                        Worked with <b>modern frontend frameworks and libraries</b>, including React and JavaScript.
                    </li>
                    <li>
                        Gained experience in <b>version control, Git, and collaborative development workflows</b>.
                    </li>
                    <li>
                        Developed <b>full-stack projects</b>, integrating databases, APIs, and UI/UX best practices.
                    </li>
                </ul>
            </div>
        </li>


    </ul>
</section>
<div id="contact" class="sectionContrastWrapper">
    <section class="sectionWrapper contact">
        <span class="contact__tag">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                    d="M8 14C7.60417 14 7.23958 13.9011 6.90625 13.7031C6.58333 13.5156 6.32292 13.2604 6.125 12.9375C5.9375 12.6042 5.84375 12.2396 5.84375 11.8437C5.84375 11.3437 5.95833 10.9271 6.1875 10.5937C6.41667 10.2604 6.77083 9.86978 7.25 9.42188C7.60417 9.09896 7.78125 8.79164 7.78125 8.49998V8.21876H7.5C7.17708 8.21876 6.73437 8.54168 6.17187 9.18752C5.61979 9.83336 4.94791 10.1562 4.15625 10.1562C3.76042 10.1562 3.39583 10.0625 3.0625 9.875C2.73958 9.67706 2.47917 9.41666 2.28125 9.09374C2.09375 8.76044 2 8.39582 2 8C2 7.60417 2.09375 7.24479 2.28125 6.92187C2.47917 6.58854 2.73958 6.32812 3.0625 6.14062C3.39583 5.94271 3.76042 5.84375 4.15625 5.84375C4.9375 5.84375 5.60416 6.16146 6.15625 6.79687C6.70833 7.43229 7.15625 7.75 7.5 7.75H7.78125V7.5C7.78125 7.20833 7.60417 6.90104 7.25 6.57813L6.89062 6.25C6.63021 6.01042 6.39063 5.72396 6.17187 5.39062C5.95312 5.04687 5.84375 4.63542 5.84375 4.15625C5.84375 3.76042 5.9375 3.40104 6.125 3.07813C6.32292 2.74479 6.58333 2.48438 6.90625 2.29687C7.23958 2.09896 7.60417 2 8 2C8.39582 2 8.75522 2.09896 9.07814 2.29687C9.41144 2.49479 9.6719 2.75521 9.8594 3.07813C10.0573 3.40104 10.1562 3.76042 10.1562 4.15625C10.1562 4.9375 9.83852 5.60416 9.20312 6.15625C8.56772 6.70833 8.25002 7.15625 8.25002 7.5V7.75H8.49998C8.85416 7.75 9.30206 7.43229 9.84374 6.79687C10.375 6.16146 11.0416 5.84375 11.8438 5.84375C12.2396 5.84375 12.5989 5.94271 12.9219 6.14062C13.2552 6.32812 13.5156 6.58333 13.7031 6.90625C13.9011 7.22917 14 7.59375 14 8C14 8.39582 13.9011 8.76044 13.7031 9.09374C13.5156 9.41666 13.2552 9.67706 12.9219 9.875C12.5989 10.0625 12.2396 10.1562 11.8438 10.1562C11.3542 10.1562 10.9323 10.0365 10.5781 9.79688C10.2344 9.5573 9.84896 9.20834 9.42188 8.75C9.09896 8.39582 8.79164 8.21876 8.49998 8.21876H8.25002V8.49998C8.25002 8.88542 8.56772 9.33332 9.20312 9.84374C9.83852 10.3542 10.1562 11.0208 10.1562 11.8437C10.1562 12.2396 10.0573 12.6042 9.8594 12.9375C9.6719 13.2604 9.41666 13.5156 9.09374 13.7031C8.77082 13.9011 8.40626 14 8 14Z"
                    fill="#779ACF" />
            </svg>
            I don't bite
        </span>
        <h2 class="contact__title">Contact me</h2>
        <p class="contact__description">Got a question, idea, or just want to chat? Drop me a line below.<br/>I'd love to hear what you have to say!</p>
        <form id="contactForm" method="POST" class="contact__form" novalidate>
            <div class="contact__inputContainer">
                <label for="Name" class="contact__label">Name</label>
                <input id="Name" name="Name" class="contact__input" placeholder="Name" required aria-required="true" maxlength="100"/>
                <span class="contact__inputError"></span>
            </div>
            <div class="contact__inputContainer">
                <label for="Email" class="contact__label">Email</label>
                <input id="Email" name="Email" class="contact__input" placeholder="Email" type="email" required aria-required="true" maxlength="100"/>
                <span class="contact__inputError"></span>
            </div>
            <div class="contact__inputContainer">
                <label for="Message" class="contact__label">Message</label>
                <textarea id="Message" name="Message" class="contact__textarea" placeholder="Message" cols="30" rows="10" required aria-required="true" maxlength="1000"></textarea>
                <span class="contact__inputError"></span>
            </div>
            <button id="contactFormBtn" type="submit" class="contact__btn">
                <svg class="contact__btnSpinner" width="20px" height="20px" fill="#fff" xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24"><path d="M23 12c0 1.042-.154 2.045-.425 3h-2.101c.335-.94.526-1.947.526-3 0-4.962-4.037-9-9-9-1.706 0-3.296.484-4.655 1.314l1.858 2.686h-6.994l2.152-7 1.849 2.673c1.684-1.049 3.659-1.673 5.79-1.673 6.074 0 11 4.925 11 11zm-6.354 7.692c-1.357.826-2.944 1.308-4.646 1.308-4.962 0-9-4.038-9-9 0-1.053.191-2.06.525-3h-2.1c-.271.955-.425 1.958-.425 3 0 6.075 4.925 11 11 11 2.127 0 4.099-.621 5.78-1.667l1.853 2.667 2.152-6.989h-6.994l1.855 2.681z"/></svg>
                Send Message
            </button>
            <span id="contactFormFeedbackTxt" class="contact__formFeedbackTxt"><span>Thanks for reaching out Frank!</span><span>I've recieved your message and will get back to you as soon as possible.</span></span>
        </form>
    </section>
</div>
<script>
    @* Insert hero email value at contact sections email input and scroll to it *@
    const heroForm = document.querySelector(".hero__form");

    heroForm.addEventListener("submit", (e) => {
        e.preventDefault();
        document.getElementById("Email").value = e.target.email.value;
        document.getElementById("contact").scrollIntoView();
        document.getElementById("Name").focus();
    });

    @* Validate form and submit *@
    const form = document.getElementById("contactForm")
    const inputs = form.querySelectorAll("input, textarea");
    const button = document.getElementById("contactFormBtn");
    const feedbackTxt = document.getElementById("contactFormFeedbackTxt");
    const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

    form.addEventListener("submit", async function(e) {
        e.preventDefault();
        // Reset feedback text
        feedbackTxt.style.display = "none";
        feedbackTxt.classList.remove("contact__formFeedbackTxt--error");

        let formIsValid = true;

        @* Check each inputs validity *@
        inputs.forEach(input => {
            const errorSpan = input.nextElementSibling;
            
            @* Guard clause for CSRF-Token *@
            if (input.name === "__RequestVerificationToken") return;

            @* Validate input with built-in browser validation *@
            if (!input.validity.valid) {
                formIsValid = false;
                errorSpan.textContent = input.validationMessage; @* Show built-in browser validation message *@
            } else {
                errorSpan.textContent = "";
            }
        });

        if (formIsValid) {
            @* Toggle btn loading state *@
            button.classList.add("contact__btn--loading");
            button.disabled = true;

            const headers = new Headers();
            headers.append('Content-Type', 'application/json');
            @* Append CSRF token if available *@
            if (csrfToken) {
                headers.append('RequestVerificationToken', csrfToken);
            }

            const body = JSON.stringify({
                Name: e.target.Name.value,
                From: e.target.Email.value,
                Subject: "Contact form submission",
                Body: e.target.Message.value
            });

            try {
                const response = await fetch('/API/Contact', {
                    method: 'POST',
                    headers: headers,
                    body: body
                });
                const responseTxt = await response.text()

                @* Handle response errors *@
                if (!response.ok) {
                    if (response.status === 429) {
                        throw new Error("I'm not gonna read that fast! Slow down a bit!");
                    } else {
                        throw new Error(responseTxt || "Failed to send message");
                    }
                }

                @* User success feedback *@
                const name = e.target.Name.value.split(" ")[0];
                feedbackTxt.style.display = "flex";
                feedbackTxt.innerHTML = `<span>Thanks for reaching out ${name}!</span><span>I've recieved your message and will get back to you as soon as possible.</span>`;
            } catch (error) {
                console.error(error);
                feedbackTxt.style.display = "flex";
                feedbackTxt.classList.add("contact__formFeedbackTxt--error");
                feedbackTxt.innerHTML = error.message;
            } finally {
                @* Reset btn loading state and clear form *@
                button.classList.remove("contact__btn--loading");
                button.disabled = false;
                form.reset();
            }
        }
    });

    @* Clear errors when inputs change *@
    inputs.forEach(input => {
        input.addEventListener("input", () => {
            const errorSpan = input.nextElementSibling;
            if (errorSpan.textContent) errorSpan.textContent = "";
        });
    });
</script>