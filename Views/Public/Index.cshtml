@* CONTACT *@
<section class="sec" id="contact">
    <div class="wrap contact-grid">
        <div class="sh">
            <p class="eyebrow">Contact</p>
            <h2 class="display">Say hi<span class="dot-accent">.</span></h2>
            <p>Wanna chat, build something, or just say hi? Shoot me a message.</p>
            <div class="contact__alt">
                @* Email is XOR-encoded and decoded by site.js on load, keeping it out of the HTML for scrapers *@
                <span>Or email <a href="#" data-email="5a3935342e3b392e1a3e3f2c303b37333474393537">[email protected]</a></span>
                <span>Code lives on <a href="https://github.com/devjamin" target="_blank" rel="noopener">GitHub</a></span>
            </div>
        </div>
        <div class="contact">
            <form class="form" id="contactForm" method="POST" novalidate>
                @* Honeypot: hidden from people, bots fill it in and get rejected server-side *@
                <div class="hp" aria-hidden="true">
                    <label for="Website">Website</label>
                    <input id="Website" name="Website" type="text" tabindex="-1" autocomplete="off" />
                </div>
                <div class="field">
                    <label for="Name">Name</label>
                    <input id="Name" name="Name" autocomplete="name" required maxlength="100" aria-describedby="NameError">
                    <span class="field__error" id="NameError"></span>
                </div>
                <div class="field">
                    <label for="Email">Email</label>
                    <input id="Email" name="Email" type="email" autocomplete="email" required maxlength="100" aria-describedby="EmailError">
                    <span class="field__error" id="EmailError"></span>
                </div>
                <div class="field field--full">
                    <label for="Message">Message</label>
                    <textarea id="Message" name="Message" rows="5" required maxlength="1000" aria-describedby="MessageError"></textarea>
                    <span class="field__error" id="MessageError"></span>
                </div>
                <div class="form__foot">
                    <p class="form__status" id="formStatus" role="status" aria-live="polite"></p>
                    <button class="btn btn--fill send" id="contactFormBtn" type="submit">
                        <span class="send__lbl">Send message</span>
                        <span class="send__icon" aria-hidden="true">
                            <svg class="i-arrow" viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
                            <svg class="i-spin" viewBox="0 0 16 16"><path d="M8 2a6 6 0 1 1-6 6" /></svg>
                            <svg class="i-check" viewBox="0 0 16 16"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" /></svg>
                        </span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>
