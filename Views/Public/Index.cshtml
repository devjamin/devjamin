@model IEnumerable<devjamin.Models.BlogPostCardViewModel>
@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="sectionWrapper hero">
    <div class="hero__infoBox">
        <p class="hero__name">Benjamin Nielsen</p>
        <h1 class="hero__title">Frontend-developer and DIY enthusiast</h1>
        <p class="hero__description">I love to learn new stuff every day</p>
        <div class="hero__cta">
            <form class="hero__form" novalidate>
                <input name="email" class="hero__input" type="email" placeholder="Enter Email" />
                <button class="hero__contact">Contact</button>
            </form>
            <a class="hero__more" asp-controller="Home" asp-action="Index" asp-fragment="experience">Learn more</a>
        </div>
    </div>
    <div class="hero__imgBox">
        <img class="hero__img" src="https://devjamin.fra1.cdn.digitaloceanspaces.com/hero_image.jpg" alt="Image of Benjamin Nielsen">
    </div>
</section>
<div id="blogs" class="sectionContrastWrapper">
    <section class="sectionWrapper blogs">
        <p class="blogs__tag">Devjamin blog</p>
        <h2 class="blogs__title">Take a look at my latest blog posts</h2>
        <div class="blogs__container">
            @foreach (var blogCard in Model)
            {
                <article class="blog">
                    <a class="blog__anchor" href="/Blog/@blogCard.Slug">
                        <img class="blog__img" src="../images/benjamin_nielsen.jpg" alt="Image of Benjamin Nielsen">
                        <span class="blog__tag">Craftsmanship</span>
                        <h3 class="blog__title">@blogCard.Title</h3>
                        <p class="blog__description">@blogCard.Description</p>
                    </a>
                </article>
            }
        </div>
        <a class="blogs__more" href="/Blogs">
