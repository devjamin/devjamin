@model IEnumerable<devjamin.Models.ArticleCardViewModel>
@{
    ViewData["Title"] = "Articles";
    ViewData["MetaDescription"] = "A collection of articles where I share personal projects, thoughts, and whatever else I’m into.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<header class="page-head">
    <div class="wrap">
        <p class="eyebrow">Articles</p>
        <h1 class="display">Writing<span class="dot-accent">.</span></h1>
        <p>Notes, guides and write-ups on frontend, infrastructure, and whatever I'm building at the moment.</p>
    </div>
</header>

<section class="page-body">
    <div class="wrap">
        @if (!Model.Any())
        {
            <p class="empty">No articles yet. The first one is on its way.</p>
        }
        else
        {
            <div class="acards">
                @foreach (var article in Model)
                {
                    <partial name="~/Views/Public/_ArticleCard.cshtml" model="article" />
                }
            </div>
        }
    </div>
</section>
